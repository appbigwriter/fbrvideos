# Apenas configuração local. Nunca colocar chaves de fornecedores no frontend.
API_HOST=127.0.0.1
API_PORT=3001
# PostgreSQL S1 local; senha de desenvolvimento, nunca usar em deployment público.
DATABASE_URL=postgresql://fbr:fbr_local_only@localhost:5432/fbr
# Armazenamento de mídia reservado para S3; Bibles originais ficam no PostgreSQL.
ASSET_STORE=filesystem
FBR_ASSET_ROOT=./var/assets
APP_TIMEZONE=America/Sao_Paulo
# Planejador selecionado: GPT-6.1 Sol via sessão OAuth do Codex local.
FBR_PLANNER=codex_oauth
# Executável nativo (codex.exe no Windows), sem shell/wrapper; login com codex login.
FBR_CODEX_EXECUTABLE=
# Provisionamento opcional de instalação privada, sob proxy HTTPS. Não ativado no ambiente local.
FBR_OPERATOR_ACCESS_TOKEN=
FBR_ALLOWED_HOSTS=
FBR_ALLOWED_ORIGINS=
# Credenciais server-only de futuras conexões; bindings precisam de schema/acesso/custo verificados.
HF_API_KEY=
HEYGEN_API_KEY=
FBR_PROVIDER_BINDINGS_MODULE=
# simulated: journal sem arquivos; synthetic: ensaio recuperável com mídia local; provisioned: runtime real configurado.
# Para ensaio explícito em API e worker: FBR_GENERATION_MODE=synthetic (sem fornecedor pago).
FBR_GENERATION_MODE=simulated
# Destino do backup completo, fora do diretório de mídia ativa.
FBR_BACKUP_ROOT=
