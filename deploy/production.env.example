# Copie para arquivo privado fora do Git e passe explicitamente com --env-file.
# Não usar a .env de desenvolvimento. Senha deve ser URL-safe (ex.: 48 hex).
POSTGRES_PASSWORD=SUBSTITUA_POR_48_CARACTERES_HEXADECIMAIS
FBR_OPERATOR_ACCESS_TOKEN=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_CARACTERES
FBR_RELEASE_TAG=local
# Ensaio sem fornecedor pago. Extrativo não equivale ao planejador semântico.
FBR_GENERATION_MODE=synthetic
FBR_PLANNER=extractive
FBR_BIND_ADDRESS=127.0.0.1
FBR_HTTPS_PORT=8443
FBR_ALLOWED_HOSTS=localhost,127.0.0.1
FBR_ALLOWED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
# Diretório com fullchain.pem e privkey.pem.
FBR_TLS_DIRECTORY=./deploy/certs
FBR_PROVIDER_BINDINGS_MODULE=
FBR_CODEX_EXECUTABLE=
HF_API_KEY=
HEYGEN_API_KEY=
